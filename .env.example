# ============================================================
# E-Commerce Platform — React Frontend Environment Variables
# ============================================================
# Copy this file to .env in the frontend directory.
# NEVER commit real credentials or private keys to Git.
# ============================================================

# Supabase Project Base URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anonymous API Key (safe for browser exposure)
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# Backend REST API Base URL (default local: http://localhost:8080)
# Production example: https://api.your-ecommerce-domain.com
VITE_API_BASE_URL=http://localhost:8080
